# --- Database -------------------------------------------------------------
# Any Postgres connection string. For a throwaway local instance run:
#   npx prisma dev
# and paste the URL it prints. For hosted Postgres use Neon or Supabase.
DATABASE_URL="postgresql://user:password@localhost:5432/adamantite?schema=public"

# --- App ------------------------------------------------------------------
# Public origin of this deployment. Required for Stripe redirects and for
# provider webhooks; on Vercel it is inferred if omitted.
APP_URL="http://localhost:3000"

# Email that should be granted the OWNER role on registration. If unset, the
# first account to register becomes the owner.
OWNER_EMAIL=""

# Random string used to derive provider webhook tokens. Generate with:
#   node -e "console.log(require(\x27crypto\x27).randomBytes(32).toString(\x27hex\x27))"
WEBHOOK_SECRET=""

# --- Higgsfield (generation) ----------------------------------------------
# Server-side credentials from https://cloud.higgsfield.ai
HIGGSFIELD_API_KEY_ID=""
HIGGSFIELD_API_KEY_SECRET=""
# Optional. Overrides catalog model id -> platform endpoint path, e.g.
# {"kling-3":"kling/kling-3.0/standard"}
HIGGSFIELD_ENDPOINT_MAP=""

# --- Stripe (billing) -----------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PORT=""
STRIPE_PRICE_STANDARD=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_MAX=""

# Contact routes shown on /contact and the legal pages. Optional; the defaults
# in src/lib/site.ts are placeholders and must be replaced before launch.
SUPPORT_EMAIL=
BILLING_EMAIL=
PRIVACY_EMAIL=
